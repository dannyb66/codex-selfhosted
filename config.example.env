# codex-selfhosted per-account config. Copy to ~/.config/codex-selfhosted/<name>.env and fill in,
# then select it with CODEX_ENV=<name>. (Or point CODEX_SELFHOSTED_CONFIG at any file.)
# NOTHING here is secret — AWS creds come from `aws-mfa.sh` -> /tmp/mfa-env-<name>.sh.

# --- AWS session (used by aws-mfa.sh) ---
AWS_PROFILE=my-aws-profile          # an `aws configure --profile` profile with a virtual MFA device
AWS_REGION=us-east-2
# AWS_ACCOUNT_ID=123456789012        # optional; derived from the profile if omitted

# --- the GPU inference service (from `terraform output`, or your existing deployment) ---
ECS_CLUSTER=codex-selfhosted-cluster
ECS_SERVICE=codex-selfhosted-gpu-service
ASG_NAME=codex-selfhosted-gpu-asg
LOG_GROUP=/ecs/codex-selfhosted
# CODEX_PORT=8000
# MAX_GPU=2

# --- Codex client behavior ---
# Curated MCP servers loaded into interactive `chat` sessions (copied from your ~/.codex).
# Keep this small enough to fit the model's context (14B/32k -> a few servers; do NOT include
# 'filesystem' — Codex writes files natively). Empty = no MCP.
CODEX_MCP_SET=github,context7
# CODEX_MCP_SET_EXEC=                # MCP for non-interactive `exec` (default: none/lean)
