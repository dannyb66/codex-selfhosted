# codex-selfhosted — awsdev (DEVCI) config. Select with: export CODEX_ENV=dev
# AWS creds come from `aws-mfa.sh` -> /tmp/mfa-env-dev.sh (nothing secret here).

# --- AWS session (used by aws-mfa.sh; the client itself uses the MFA-file creds) ---
AWS_PROFILE=awsdev
AWS_REGION=us-east-2

# --- the live awsdev GPU inference service ---
ECS_CLUSTER=dev-cluster-for-web
ECS_SERVICE=devci-llm-inference-gpu-service
ASG_NAME=devci-llm-gpu-asg
LOG_GROUP=/ecs/devci-llm-inference
CODEX_PORT=8000
MAX_GPU=1   # one shared box (vLLM batches all sessions); ASG max is also 1 to stop the cold-start 2-instance overshoot

# --- Codex client ---
# Curated MCP loaded into interactive `chat` (from your ~/.codex). Keep small; no 'filesystem'.
CODEX_MCP_SET=github,context7
# The role-proxy (developer->system, input_text flatten) is on by default so Codex works with
# vLLM 0.30.0. Set CODEX_PROXY=0 to bypass it.
