# codex-selfhosted — DEFAULT config: the reference awsdev (DEVCI) GPU inference deployment.
# `bin/codex-selfhosted init` (no CODEX_ENV) copies this to ~/.config/codex-selfhosted/default.env.
# NOTHING here is secret — AWS creds come from `aws-mfa.sh` -> /tmp/mfa-env-default.sh.
# Deploying your OWN stack instead? Seed the generic template: `CODEX_ENV=<name> bin/codex-selfhosted init`
# (copies config.example.env) and fill the values from `terraform output`.

# --- AWS session (used by aws-mfa.sh; the client itself uses the MFA-file creds) ---
AWS_PROFILE=awsdev                 # your local `aws configure --profile` name for account 235391889963 (change if yours differs)
AWS_REGION=us-east-2

# --- the live awsdev GPU inference service (account 235391889963, us-east-2) ---
ECS_CLUSTER=dev-cluster-for-web
ECS_SERVICE=devci-llm-inference-gpu-service
ASG_NAME=devci-llm-gpu-asg
LOG_GROUP=/ecs/devci-llm-inference
CODEX_PORT=8000
MAX_GPU=1   # one shared box (vLLM batches all sessions); ASG max is also 1 to stop the cold-start 2-instance overshoot

# --- Codex client ---
CODEX_MCP_SET=github,context7   # curated MCP loaded into interactive `chat` (from your ~/.codex); keep small, no 'filesystem'
# The role-proxy (developer->system + input_text flatten) is on by default so Codex works with
# vLLM 0.30.0. Set CODEX_PROXY=0 to bypass it.
