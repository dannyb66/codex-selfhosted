#!/usr/bin/env bash
# codex-selfhosted — drive the OpenAI Codex CLI against a self-hosted vLLM GPU service on AWS.
# Portable + multi-account: all AWS/ECS names come from a per-account config, not hardcoded.
#
#   codex-selfhosted up             warm the GPU (min=1), open the SSM tunnel, start the idle-auto-down reaper
#   codex-selfhosted chat ["task"]  INTERACTIVE streaming session (bare `codex` TUI) — run from many terminals
#   codex-selfhosted resume [id]    resume a past `chat` (no id -> picker; --last -> most recent; --all -> any cwd)
#   codex-selfhosted exec "task"    non-interactive one-shot (`codex exec`), lean (no MCP unless CODEX_MCP_SET_EXEC)
#   codex-selfhosted run  ["task"]  up (if needed) then chat
#   codex-selfhosted status         show GPU + tunnel + endpoint
#   codex-selfhosted down           scale the GPU to $0 and close the shared tunnel
#
# Concurrency: ONE shared tunnel on a fixed local port; the vLLM server handles concurrency
# (continuous batching). `chat`/`resume` share a persistent CODEX_HOME per env (so session rollouts
# survive for `resume`); `exec` gets its own throwaway CODEX_HOME. Run `chat` from N terminals at once.
#
# Config: sourced from $CODEX_SELFHOSTED_CONFIG or ~/.config/codex-selfhosted/${CODEX_ENV:-default}.env
#   Required: AWS_PROFILE AWS_REGION ECS_CLUSTER ECS_SERVICE ASG_NAME LOG_GROUP
#   Optional: CODEX_PORT(8000) CODEX_MCP_SET(github,context7,...) AWS_ACCOUNT_ID
#             CODEX_IDLE_REAPER(1=auto-down when idle) CODEX_IDLE_TTL_MIN(30 min idle before auto-down)
# MFA: run `aws-mfa.sh <code>` first (writes /tmp/mfa-env-${CODEX_ENV}.sh). See README.
set -uo pipefail

CODEX_ENV="${CODEX_ENV:-default}"
CFG="${CODEX_SELFHOSTED_CONFIG:-$HOME/.config/codex-selfhosted/$CODEX_ENV.env}"
die() { echo "ERROR: $*" >&2; exit 1; }
[ -f "$CFG" ] && . "$CFG" || echo "note: no config at $CFG (using env vars)" >&2

: "${AWS_REGION:?set AWS_REGION (in $CFG)}"
: "${ECS_CLUSTER:?set ECS_CLUSTER (in $CFG)}"
: "${ECS_SERVICE:?set ECS_SERVICE (in $CFG)}"
: "${ASG_NAME:?set ASG_NAME (in $CFG)}"
: "${LOG_GROUP:?set LOG_GROUP (in $CFG)}"
REGION="$AWS_REGION"; CLUSTER="$ECS_CLUSTER"; SVC="$ECS_SERVICE"; ASG="$ASG_NAME"; LG="$LOG_GROUP"
PORT="${CODEX_PORT:-8000}"
SCALABLE="service/$CLUSTER/$SVC"
BASE="http://localhost:$PORT"
PIDFILE="/tmp/codex-selfhosted-tunnel-$CODEX_ENV.pid"
TLOG="/tmp/codex-selfhosted-tunnel-$CODEX_ENV.log"
MFA="/tmp/mfa-env-$CODEX_ENV.sh"
USER_CODEX_CONFIG="$HOME/.codex/config.toml"
# Persistent CODEX_HOME for `chat`/`resume` so session rollouts survive (exec stays ephemeral).
CODEX_HOME_DIR="${CODEX_HOME_PERSIST:-$HOME/.config/codex-selfhosted/codexhome-$CODEX_ENV}"
CODEX_MCP_SET="${CODEX_MCP_SET:-github,context7}"
CODEX_EFFORT="${CODEX_REASONING_EFFORT:-xhigh}"   # default reasoning effort. Qwen3.8 (qwen3 parser) accepts xhigh|medium|low (NOT high); coder-30b has no reasoning parser so it ignores this.
# Codex<->vLLM-0.30.0 compatibility proxy: Codex sends a 'developer' role + typed 'input_text'
# content chunks that vLLM 0.30.0 rejects (400) for ANY model. codex-role-proxy.py sits in front of
# the tunnel and rewrites them; Codex points at the proxy. Set CODEX_PROXY=0 to bypass it.
PROXY_PORT="${CODEX_PROXY_PORT:-8891}"
PROXY_BASE="http://localhost:$PROXY_PORT"
PROXY_PIDFILE="/tmp/codex-selfhosted-proxy-$CODEX_ENV.pid"
PROXY_LOG="/tmp/codex-selfhosted-proxy-$CODEX_ENV.log"
ROLE_PROXY="$(cd "$(dirname "$0")" && pwd)/codex-role-proxy.py"
[ "${CODEX_PROXY:-1}" = "1" ] && CODEX_BASE="$PROXY_BASE" || CODEX_BASE="$BASE"
# Idle auto-down (Layer 1): `up` starts a client-side reaper alongside the tunnel/proxy. It polls
# vLLM /metrics through the tunnel and runs `down` after CODEX_IDLE_TTL_MIN of no request activity.
CODEX_IDLE_REAPER="${CODEX_IDLE_REAPER:-1}"      # 1=auto-down when idle; 0=stay warm until manual `down`
CODEX_IDLE_TTL_MIN="${CODEX_IDLE_TTL_MIN:-30}"   # minutes of no vLLM activity before auto-down
REAPER_PIDFILE="/tmp/codex-selfhosted-reaper-$CODEX_ENV.pid"
REAPER_LOG="/tmp/codex-selfhosted-reaper-$CODEX_ENV.log"

[ -f "$MFA" ] || die "no $MFA — run: source \"\$(dirname \"\$0\")/aws-mfa.sh\" <MFA_CODE>  (CODEX_ENV=$CODEX_ENV)"
set -a; . "$MFA" 2>/dev/null; set +a
command -v aws >/dev/null || die "aws cli not found"

running_task() { aws ecs list-tasks --cluster "$CLUSTER" --service-name "$SVC" --desired-status RUNNING --region "$REGION" --query 'taskArns[0]' --output text 2>/dev/null; }

resolve_targets() {  # -> "IP EC2" or non-zero
  local t ip ci ec2
  t=$(running_task); { [ "$t" = "None" ] || [ -z "$t" ]; } && return 1
  ip=$(aws ecs describe-tasks --cluster "$CLUSTER" --tasks "$t" --region "$REGION" --query "tasks[0].attachments[0].details[?name=='privateIPv4Address'].value|[0]" --output text 2>/dev/null)
  ci=$(aws ecs describe-tasks --cluster "$CLUSTER" --tasks "$t" --region "$REGION" --query "tasks[0].containerInstanceArn" --output text 2>/dev/null)
  ec2=$(aws ecs describe-container-instances --cluster "$CLUSTER" --container-instances "$ci" --region "$REGION" --query "containerInstances[0].ec2InstanceId" --output text 2>/dev/null)
  { [ -z "$ip" ] || [ "$ip" = "None" ] || [ -z "$ec2" ] || [ "$ec2" = "None" ]; } && return 1
  echo "$ip $ec2"
}

tunnel_up()   { curl -sf --max-time 4 "$BASE/health" >/dev/null 2>&1; }   # --max-time: fast-fail if a stale tunnel half-opens the port
served_model(){ curl -sf --max-time 6 "$BASE/v1/models" 2>/dev/null | python3 -c "import sys,json; print((json.load(sys.stdin).get('data') or [{}])[0].get('id',''))" 2>/dev/null; }

make_codex_home() {  # $1=served model; $2=optional home dir (default: fresh mktemp/ephemeral). honors CODEX_MCP_SET
  local m="$1" home="${2:-}" cwd tmp
  cwd=$(pwd)
  [ -n "$home" ] || home=$(mktemp -d "${TMPDIR:-/tmp}/codex-selfhosted.XXXXXX")
  mkdir -p "$home"
  tmp="$home/.config.toml.$$"   # build in a temp then atomic mv, so a concurrent chat sharing this
  {                             # persistent home never reads a half-written (e.g. MCP-less) config.toml
    printf 'model = "%s"\n' "$m"
    printf 'model_provider = "selfhosted"\n'
    printf 'model_reasoning_effort = "%s"\n' "$CODEX_EFFORT"
    printf '[model_providers.selfhosted]\n'
    printf 'name = "Self-hosted vLLM"\n'
    printf 'base_url = "%s/v1"\n' "$CODEX_BASE"
    printf 'wire_api = "responses"\n'
    printf '[history]\npersistence = "none"\n'   # command-history only; session rollouts still persist (verified) so `resume` works
    printf '[tui]\nshow_tooltips = false\n'
    printf '[projects."%s"]\ntrust_level = "trusted"\n' "$cwd"
  } > "$tmp"
  if [ -n "$CODEX_MCP_SET" ] && [ -f "$USER_CODEX_CONFIG" ]; then
    CODEX_MCP_SET="$CODEX_MCP_SET" python3 - "$USER_CODEX_CONFIG" >> "$tmp" <<'PY'
import os, re, sys
ids = {x.strip() for x in os.environ.get("CODEX_MCP_SET", "").split(",") if x.strip()}
lines = open(sys.argv[1]).read().splitlines(keepends=True)
hdr = re.compile(r'^\s*\[mcp_servers\.([^.\]]+)')
out, i, n = [], 0, len(lines)
while i < n:
    m = hdr.match(lines[i])
    if m and m.group(1) in ids:
        out.append(lines[i]); i += 1
        while i < n and not re.match(r'^\s*\[', lines[i]):
            out.append(lines[i]); i += 1
    else:
        i += 1
sys.stdout.write("".join(out))
PY
  fi
  mv -f "$tmp" "$home/config.toml"   # atomic swap: a concurrent reader sees the previous complete file or this one
  echo "$home"
}

ensure_serving() {
  tunnel_up && return 0
  echo "[up] warm GPU (min=1)..."
  aws application-autoscaling register-scalable-target --service-namespace ecs \
    --resource-id "$SCALABLE" --scalable-dimension ecs:service:DesiredCount \
    --min-capacity 1 --max-capacity "${MAX_GPU:-2}" --region "$REGION" >/dev/null || die "register-scalable-target failed"
  # Already warm (a task is running from a prior/other session)? Skip the cold-start log-wait —
  # the "Application startup complete" line is hours old on a warm box, so waiting for a *recent*
  # one would false-hang. open_tunnel's /health retries confirm the model is actually serving.
  local running
  running=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SVC" --region "$REGION" --query 'services[0].runningCount' --output text 2>/dev/null)
  if [[ "${running:-0}" =~ ^[1-9][0-9]*$ ]]; then echo "[up] task already running — skipping cold-start wait."; return 0; fi
  echo "[up] waiting for the model to serve (cold start ~10 min)..."
  local i start t0 el rc
  t0=$(date +%s)
  for i in $(seq 1 60); do
    start=$(( ($(date +%s) - 90) * 1000 ))
    [ "$(aws logs filter-log-events --log-group-name "$LG" --region "$REGION" --start-time "$start" --filter-pattern '?"Application startup complete" ?"Uvicorn running on http"' --query 'length(events)' --output text 2>/dev/null)" != "0" ] && { echo "[up] model serving."; return 0; }
    [ "$i" = 60 ] && die "timed out waiting for serving (check: $0 status)"
    if [ $((i % 3)) = 0 ]; then   # ~every 60s: heartbeat so a long cold start never looks hung
      el=$(( $(date +%s) - t0 ))
      rc=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SVC" --region "$REGION" --query 'services[0].[runningCount,pendingCount]' --output text 2>/dev/null | tr '\t' '/')
      echo "[up]   ...still warming (${el}s elapsed; task running/pending=${rc:-?}) — normal, not a hang"
    fi
    sleep 20
  done
}

open_tunnel() {
  tunnel_up && { echo "[up] tunnel already up."; return 0; }
  local tg ip ec2 i
  tg=$(resolve_targets) || die "could not resolve the running task's ENI/host"
  ip=${tg% *}; ec2=${tg#* }
  echo "[up] opening shared SSM tunnel  localhost:$PORT -> $ip:$PORT via $ec2 ..."
  [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
  lsof -ti "TCP:$PORT" -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null || true   # reap any stale session-manager-plugin still holding :$PORT before rebinding
  nohup aws ssm start-session --target "$ec2" \
    --document-name AWS-StartPortForwardingSessionToRemoteHost \
    --parameters "host=$ip,portNumber=$PORT,localPortNumber=$PORT" --region "$REGION" >"$TLOG" 2>&1 &
  echo $! > "$PIDFILE"
  for i in $(seq 1 20); do tunnel_up && break; sleep 2; done
  tunnel_up || die "tunnel did not come up (see $TLOG)"
}

start_proxy() {   # Codex<->vLLM-0.30.0 compat shim (developer->system, input_text flatten)
  [ "${CODEX_PROXY:-1}" = "1" ] || return 0
  curl -sf "$PROXY_BASE/health" >/dev/null 2>&1 && { echo "[up] role-proxy already up."; return 0; }
  [ -f "$ROLE_PROXY" ] || { echo "[up] WARN: role-proxy missing ($ROLE_PROXY) — Codex may 400 on the developer role" >&2; return 0; }
  [ -f "$PROXY_PIDFILE" ] && kill "$(cat "$PROXY_PIDFILE")" 2>/dev/null
  PROXY_UPSTREAM="$BASE" PROXY_PORT="$PROXY_PORT" nohup python3 "$ROLE_PROXY" >"$PROXY_LOG" 2>&1 &
  echo $! > "$PROXY_PIDFILE"
  local i; for i in $(seq 1 10); do curl -sf "$PROXY_BASE/health" >/dev/null 2>&1 && break; sleep 1; done
  curl -sf "$PROXY_BASE/health" >/dev/null 2>&1 && echo "[up] role-proxy on $PROXY_BASE -> $BASE" || echo "[up] WARN: role-proxy did not come up (see $PROXY_LOG)" >&2
}

start_reaper() {   # idempotent: idle auto-down watchdog (Layer 1); polls vLLM /metrics via the tunnel
  [ "$CODEX_IDLE_REAPER" = "1" ] || { echo "[up] idle-reaper OFF (CODEX_IDLE_REAPER=0) — remember to $0 down"; return 0; }
  if [ -f "$REAPER_PIDFILE" ] && kill -0 "$(cat "$REAPER_PIDFILE")" 2>/dev/null; then echo "[up] idle-reaper already running."; return 0; fi
  nohup "$0" __reap >"$REAPER_LOG" 2>&1 &
  echo $! > "$REAPER_PIDFILE"
  echo "[up] idle-reaper ON: auto-down after ${CODEX_IDLE_TTL_MIN}m idle (disable: CODEX_IDLE_REAPER=0; log: $REAPER_LOG)"
}

cmd_reap() {   # internal (__reap): loop until vLLM has been idle >= TTL, then scale to zero. started by `up`.
  local last now idle succ prev metrics running ttl
  ttl=${CODEX_IDLE_TTL_SEC:-$(( CODEX_IDLE_TTL_MIN * 60 ))}; last=$(date +%s); prev=""   # TTL_SEC overrides for testing/tuning
  echo "[reaper] started $(date -u +%H:%M:%SZ)  ttl=${ttl}s poll=${CODEX_REAP_POLL:-60}s"
  while :; do
    sleep "${CODEX_REAP_POLL:-60}"
    metrics=$(curl -sf --max-time 5 "$BASE/metrics" 2>/dev/null)   # scrape through the tunnel (both lanes' activity)
    if [ -n "$metrics" ]; then
      running=$(printf '%s\n' "$metrics" | awk '/^vllm:num_requests_(running|waiting)/{r+=$2} END{printf "%d", r+0}')
      succ=$(printf '%s\n' "$metrics" | awk '/^vllm:request_success_total/{s+=$2} END{printf "%d", s+0}')
      if [ "${running:-0}" != "0" ] || { [ -n "$prev" ] && [ "$succ" != "$prev" ]; }; then last=$(date +%s); fi
      prev="$succ"
    fi
    now=$(date +%s); idle=$(( now - last ))
    if [ "$idle" -ge "$ttl" ]; then
      echo "[reaper] idle ${idle}s >= ${ttl}s — AUTO-DOWN $(date -u +%H:%M:%SZ)"
      [ -f "$MFA" ] && { set -a; . "$MFA" 2>/dev/null; set +a; }   # re-source creds in case they were refreshed
      rm -f "$REAPER_PIDFILE"                                       # drop our pid first so scale_to_zero won't kill us mid-down
      scale_to_zero
      echo "[reaper] done $(date -u +%H:%M:%SZ)."
      exit 0
    fi
  done
}

cmd_up() {
  ensure_serving; open_tunnel; start_proxy; start_reaper
  local m; m=$(served_model); [ -n "$m" ] || die "endpoint up but /v1/models empty"
  echo "[up] READY ($CODEX_ENV). served model: $m"
  echo "     chat:  $0 chat        done:  $0 down"
}

cmd_chat() {
  tunnel_up || die "tunnel not up — run: $0 up"
  start_proxy   # idempotent: Codex points at the proxy, so make sure it's running
  local m home; m=$(served_model); [ -n "$m" ] || die "endpoint not serving"
  home=$(make_codex_home "$m" "$CODEX_HOME_DIR")   # persistent home: session rollouts survive here for `resume`
  echo "[chat] model=$m  MCP=[$CODEX_MCP_SET]  (/quit to exit; resume later with: $0 resume)"
  CODEX_HOME="$home" codex --sandbox workspace-write -c model_provider=selfhosted -c model="$m" ${1:+"$1"}
}

cmd_resume() {   # resume a saved chat session: resume [SESSION_ID | --last | --all] [prompt]
  tunnel_up || die "tunnel not up — run: $0 up"
  start_proxy
  local m; m=$(served_model); [ -n "$m" ] || die "endpoint not serving"
  make_codex_home "$m" "$CODEX_HOME_DIR" >/dev/null   # refresh provider/model in the persistent home
  echo "[resume] model=$m  home=$CODEX_HOME_DIR  args=[${*:-<picker>}]  (sessions are cwd-filtered; add --all for other dirs)"
  CODEX_HOME="$CODEX_HOME_DIR" codex resume \
    -c model_provider=selfhosted -c model="$m" -c sandbox_mode="workspace-write" -c approval_policy="never" "$@"
}

cmd_exec() {
  [ -n "${1:-}" ] || die "usage: $0 exec \"<task>\""
  tunnel_up || die "tunnel not up — run: $0 up"
  start_proxy
  local m home; m=$(served_model); [ -n "$m" ] || die "endpoint not serving"
  home=$(CODEX_MCP_SET="${CODEX_MCP_SET_EXEC:-}" make_codex_home "$m"); trap "rm -rf '$home'" EXIT   # bake path in (see cmd_chat)
  echo "[exec] model=$m"
  CODEX_HOME="$home" codex exec --skip-git-repo-check -s workspace-write -c approval_policy="never" \
    -c model_provider=selfhosted -c model="$m" "$1"
}

cmd_status() {
  local d r m tp
  d=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SVC" --region "$REGION" --query 'services[0].desiredCount' --output text 2>/dev/null)
  r=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SVC" --region "$REGION" --query 'services[0].runningCount' --output text 2>/dev/null)
  echo "env=$CODEX_ENV  GPU service: desired=$d running=$r"
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then tp="up (pid $(cat "$PIDFILE"))"; else tp="down"; fi
  echo "tunnel: $tp"
  if [ -f "$PROXY_PIDFILE" ] && kill -0 "$(cat "$PROXY_PIDFILE")" 2>/dev/null; then echo "role-proxy: up ($PROXY_BASE, Codex uses this)"; else echo "role-proxy: down"; fi
  if [ -f "$REAPER_PIDFILE" ] && kill -0 "$(cat "$REAPER_PIDFILE")" 2>/dev/null; then echo "idle-reaper: on (auto-down after ${CODEX_IDLE_TTL_MIN}m idle)"; else echo "idle-reaper: off"; fi
  if tunnel_up; then m=$(served_model); echo "endpoint: serving ($m)"; else echo "endpoint: unreachable"; fi
}

scale_to_zero() {   # the actual down: scale service+ASG to 0 and close tunnel/proxy/reaper. shared by `down` + reaper.
  aws application-autoscaling register-scalable-target --service-namespace ecs \
    --resource-id "$SCALABLE" --scalable-dimension ecs:service:DesiredCount \
    --min-capacity 0 --max-capacity "${MAX_GPU:-2}" --region "$REGION" >/dev/null 2>&1
  aws ecs update-service --cluster "$CLUSTER" --service "$SVC" --desired-count 0 --region "$REGION" >/dev/null 2>&1
  aws autoscaling update-auto-scaling-group --auto-scaling-group-name "$ASG" --min-size 0 --desired-capacity 0 --region "$REGION" 2>/dev/null
  [ -f "$REAPER_PIDFILE" ] && { kill "$(cat "$REAPER_PIDFILE")" 2>/dev/null; rm -f "$REAPER_PIDFILE"; }   # no-op if the reaper itself is calling
  [ -f "$PIDFILE" ] && { kill "$(cat "$PIDFILE")" 2>/dev/null; rm -f "$PIDFILE"; }
  lsof -ti "TCP:$PORT" -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null || true   # reap the session-manager-plugin child that keeps :$PORT open after the aws parent dies
  [ -f "$PROXY_PIDFILE" ] && { kill "$(cat "$PROXY_PIDFILE")" 2>/dev/null; rm -f "$PROXY_PIDFILE"; }
}

cmd_down() {
  echo "[down] scale GPU to 0 ($CODEX_ENV)..."
  scale_to_zero
  echo "[down] GPU scaling to \$0; tunnel + role-proxy + idle-reaper closed."
}

case "${1:-}" in
  up)     cmd_up ;;
  chat)   shift; cmd_chat "${1:-}" ;;
  exec)   shift; cmd_exec "${*:-}" ;;
  run)    tunnel_up || cmd_up; shift; cmd_chat "${1:-}" ;;
  resume) shift; cmd_resume "$@" ;;
  status) cmd_status ;;
  down)   cmd_down ;;
  __reap) cmd_reap ;;   # internal: the idle-auto-down watchdog started by `up`
  *) echo "usage: CODEX_ENV=<acct> $0 {up|chat [\"task\"]|resume [id|--last|--all]|exec \"task\"|run [\"task\"]|status|down}"; exit 1 ;;
esac
